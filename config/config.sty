% ---------- Palet Warna Resmi Templat Word (100% Exact Hex) ----------
\definecolor{placeholdergray}{HTML}{7F7F7F} % Teks abu-abu: placeholder & petunjuk
\definecolor{wajibred}{HTML}{C00000}        % Label status WAJIB
\definecolor{opsionalolive}{HTML}{7F6000}   % Label status Opsional
\definecolor{shadeheader}{HTML}{F2F2F2}     % Latar header tabel / Tidak diperlukan
\definecolor{shadewajib}{HTML}{FCE4D6}      % Latar sel WAJIB
\definecolor{shadeopsional}{HTML}{FFF2CC}   % Latar sel Opsional
\definecolor{shadebiru}{HTML}{BDD6EE}       % Latar header Peta Kewajiban
\definecolor{photoborder}{HTML}{808080}     % Bingkai pasfoto abu-abu 0,75 pt

% ---------- Format Judul Bagian & Subbagian (Word Heading Replication) ----------
% Judul Bagian Utama: tengah, tebal, 14pt, spasi 1, space-after 5pt
\newcommand{\judulbagian}[1]{%
  \noindent{\centering\bfseries\fontsize{14}{14}\selectfont #1\par}%
  \vspace{5pt}%
}

% Subbagian: rata kiri, tebal, 11pt, space-before 2pt, space-after 0pt
\newcommand{\subbagian}[1]{%
  \vspace{2pt}%
  \noindent{\bfseries #1\par}%
}

% Teks placeholder abu-abu
\newcommand{\placeholder}[1]{\textcolor{placeholdergray}{#1}}

% Label status regulasi Peta Kewajiban
\newcommand{\WAJIB}{\textbf{\textcolor{wajibred}{WAJIB}}}
\newcommand{\WAJIBF}{\textbf{\textcolor{wajibred}{WAJIB (final)}}}
\newcommand{\WAJIBBILA}{\textbf{\textcolor{wajibred}{WAJIB bila berlaku}}}
\newcommand{\OPSIONAL}{\textbf{\textcolor{opsionalolive}{Opsional}}}
\newcommand{\TIDAKPERLU}{\textcolor{placeholdergray}{Tidak diperlukan}}

% Blok petunjuk penulisan (miring 9.5pt abu-abu)
\newcommand{\petunjuk}[2]{%
  \noindent\begingroup\singlespacing\fontsize{9.5}{11.5}\selectfont\itshape\color{placeholdergray}%
  \textbf{Petunjuk:} #1%
  \ifx\\#2\\%
  \else\ \ #2\fi
  \par\endgroup%
  \vspace{0.5pt}%
}
\newcommand{\statusdua}[2]{[\textit{Seminar proposal:} #1 \textperiodcentered\ \textit{Sidang akhir:} #2]}

% ---------- Kop Halaman (fancyhdr) Sesuai Tabel 8.4 Pedoman TA ITERA ----------
% 1. Sampul: tanpa nomor sama sekali
\fancypagestyle{sampul}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
}

% 2. Bagian Depan (front matter): nomor romawi kecil di footer tengah, header kosong
\fancypagestyle{depan}{%
  \fancyhf{}%
  \fancyfoot[C]{\fontsize{10}{10}\selectfont\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
}

% 3. Badan Laporan: nomor Arab di header luar (RO di ganjil, LE di genap), footer kosong
\fancypagestyle{badan}{%
  \fancyhf{}%
  \fancyhead[RO]{\fontsize{10}{10}\selectfont\thepage}%
  \fancyhead[LE]{\fontsize{10}{10}\selectfont\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
}

% 4. Halaman Pertama Tiap Bab / Lampiran: nomor Arab di footer tengah, header kosong
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\fontsize{10}{10}\selectfont\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}%
}

% Perintah transisi bab & bagian
\newcommand{\babbaru}[2]{%
  \clearpage
  \thispagestyle{plain}%
  \phantomsection\addcontentsline{toc}{chapter}{#1}%
  \judulbagian{#1}%
  #2%
}

\newcommand{\bagiandepan}[1]{%
  \clearpage
  \phantomsection\addcontentsline{toc}{chapter}{#1}%
  \judulbagian{#1}%
}

% ---------- Konfigurasi Caption Tabel & Gambar ----------
\captionsetup[figure]{font=footnotesize,labelfont=bf,labelsep=space}
\captionsetup[table]{font=footnotesize,labelfont=bf,labelsep=space}
\captionsetup[lstlisting]{font=footnotesize,labelfont=bf,labelsep=space}

\renewcommand{\thefigure}{\arabic{chapter}.\arabic{figure}}
\renewcommand{\thetable}{\arabic{chapter}.\arabic{table}}
\renewcommand{\theequation}{\arabic{chapter}.\arabic{equation}}

% ---------- Konfigurasi Daftar Isi, Tabel, & Gambar (tocloft) ----------
