% ---------- Geometri Naskah UNESCO: 15,5 cm x 23,0 cm ----------
% Margin: atas 2 cm, bawah 2 cm, sisi dalam (jilid) 2,5 cm, sisi luar 2 cm
% Header dist: 1,23 cm (headsep=0.42cm), Footer dist: 1,06 cm (footskip=0.94cm)
\usepackage[paperwidth=15.5cm,paperheight=23cm,%
            top=2cm,bottom=2cm,inner=2.5cm,outer=2cm,%
            headheight=10pt,headsep=0.42cm,footskip=0.94cm]{geometry}

% ---------- Tipografi: Times New Roman 11 pt via TeXGyreTermesX / fontspec ----------
\usepackage{fontspec}
\IfFontExistsTF{TeXGyreTermesX-Regular.otf}{%
  \setmainfont[
    Path=D:/LaTex/fonts/opentype/public/newtx/,
    UprightFont=TeXGyreTermesX-Regular.otf,
    BoldFont=TeXGyreTermesX-Bold.otf,
    ItalicFont=TeXGyreTermesX-Italic.otf,
    BoldItalicFont=TeXGyreTermesX-BoldItalic.otf
  ]{TeXGyreTermesX}
}{%
  \setmainfont{Times New Roman}
}

