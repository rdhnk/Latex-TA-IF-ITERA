% ---------- Konfigurasi Blok Kode Program (listings) ----------
\usepackage{listings}
\lstset{
  language=Python,
  basicstyle=\ttfamily\fontsize{9}{11}\selectfont,
  numbers=left,
  numberstyle=\tiny\color{gray},
  stepnumber=1,
  numbersep=8pt,
  showstringspaces=false,
  frame=single,
  rulecolor=\color{black!30},
  backgroundcolor=\color{shadeheader},
  breaklines=true,
  breakatwhitespace=true,
  commentstyle=\color{gray}\itshape,
  keywordstyle=\color{blue}\bfseries,
  stringstyle=\color{purple},
  keepspaces=true,
  xleftmargin=12pt,
  xrightmargin=5pt,
  aboveskip=8pt,
  belowskip=8pt
}

